# Copy to backend/.env and fill in.

# Supabase > Project Settings > Database > Connection string (URI). Use the session pooler on IPv4-only hosts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Same project the frontend signs in with (frontend/.env.local VITE_SUPABASE_URL / publishable key).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Comma-separated origins allowed by CORS.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Optional
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=20
# MAX_DOCUMENTS_PER_SESSION=20
# DEBUG=false
# LLM_API_KEY=
